{
  "name": "kasa-digital-archive-backend",
  "version": "0.14.1",
  "private": true,
  "description": "Backend API KASA Digital Archive — Tahap 14.1 Maintenance Enforcement & Local Readiness",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check-all.js",
    "auth:secret": "node scripts/generate-jwt-secret.js",
    "auth:test": "node scripts/test-login.js",
    "migrate:users": "node scripts/migrate-legacy-users.js",
    "auth:verify": "node scripts/verify-auth.js",
    "drive:auth": "node scripts/google-drive-auth.js",
    "drive:test": "node scripts/test-google-drive.js",
    "migrate:archive:dry": "node scripts/migrate-legacy-archive.js --dry-run",
    "migrate:archive": "node scripts/migrate-legacy-archive.js --apply",
    "migrate:archive:verify": "node scripts/verify-legacy-archive.js",
    "production:check": "node scripts/production-readiness.js",
    "production:check:strict": "node scripts/production-readiness.js --strict"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.8"
  }
}
