# KASA Digital Archive — root safety ignore
**/node_modules/
**/dist/
**/.env
**/.env.*
!**/.env.example
*.log
.DS_Store
Thumbs.db

# NEVER commit Google OAuth client secret JSON
backend/google-oauth-client.json
backend/client_secret*.json

# Local migration reports/backups can contain internal metadata
backend/migration/backups/
backend/migration/reports/
