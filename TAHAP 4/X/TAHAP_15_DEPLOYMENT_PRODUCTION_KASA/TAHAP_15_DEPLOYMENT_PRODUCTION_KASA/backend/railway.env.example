# =============================================
# KASA DIGITAL ARCHIVE — RAILWAY PRODUCTION
# TEMPLATE ONLY. JANGAN COMMIT NILAI SECRET ASLI.
# =============================================
NODE_ENV=production
API_PREFIX=/api/v1
# JANGAN set PORT. Railway inject PORT otomatis.

# Setelah Cloudflare Pages live, isi URL persis tanpa slash terakhir.
# Untuk beberapa origin, pisahkan dengan koma.
FRONTEND_URLS=https://YOUR-PROJECT.pages.dev

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=

JWT_ACCESS_SECRET=REPLACE_WITH_EXISTING_LONG_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=kasa-digital-archive-api
JWT_AUDIENCE=kasa-digital-archive-web
SESSION_NORMAL_HOURS=8
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=kasa_refresh
# pages.dev -> railway.app berbeda site; butuh None + Secure di production.
REFRESH_COOKIE_SAME_SITE=none
REFRESH_COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=REPLACE_ME

APP_NAME=KASA DIGITAL ARCHIVE
COMPANY_NAME=PT. KASA GROUP
APP_VERSION=FULLSTACK-0.15.0

# Hanya dibutuhkan untuk tooling migrasi lama; runtime normal tidak membutuhkannya.
LEGACY_SPREADSHEET_ID=10v4UzQPrqGIZD3l4xMtRVApTARXVnYU4kbeX6vkBuqE
LEGACY_FOLDER_PASSWORD_PEPPER=
