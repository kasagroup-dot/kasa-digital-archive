# =============================================================
# KASA DIGITAL ARCHIVE — BACKEND ENVIRONMENT
# Copy file ini menjadi .env untuk development lokal.
# JANGAN upload .env ke GitHub.
# =============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Frontend lokal. Nanti Cloudflare URL ditambahkan setelah deployment frontend.
# Untuk lebih dari satu origin, pisahkan dengan koma.
FRONTEND_URLS=http://localhost:5173

# -------------------------------------------------------------
# SUPABASE DATABASE
# Tahap 4 belum melakukan query database.
# Nilai ini akan kita isi dan test pada TAHAP 5.
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# AUTH — digunakan mulai TAHAP 6.
# Jangan gunakan contoh ini di production.
# -------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# -------------------------------------------------------------
# GOOGLE DRIVE — digunakan pada tahap integrasi storage.
# -------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

APP_NAME=KASA DIGITAL ARCHIVE
COMPANY_NAME=PT. KASA GROUP
APP_VERSION=FULLSTACK-0.4.0
