# =============================================================
# KASA DIGITAL ARCHIVE — BACKEND ENVIRONMENT
# Copy file ini menjadi .env untuk development lokal.
# JANGAN upload .env ke GitHub.
# =============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URLS=http://localhost:5173

# -------------------------------------------------------------
# SUPABASE DATABASE — TAHAP 5
# -------------------------------------------------------------
# Project URL dari Supabase Dashboard.
SUPABASE_URL=

# Gunakan SECRET KEY baru (sb_secret_...) untuk backend.
# Jangan pernah taruh key ini di React/browser/GitHub.
SUPABASE_SECRET_KEY=

# Legacy fallback saja. Biarkan kosong jika sudah memakai SECRET KEY baru.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# AUTH — digunakan mulai TAHAP 6.
# -------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# -------------------------------------------------------------
# GOOGLE DRIVE — digunakan pada tahap integrasi storage.
# -------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

APP_NAME=KASA DIGITAL ARCHIVE
COMPANY_NAME=PT. KASA GROUP
APP_VERSION=FULLSTACK-0.5.0
